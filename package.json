{
  "name": "gifto-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "node scripts/verify-tailwind-css.mjs",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:security": "playwright test --config=playwright.security.config.ts",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "test:e2e:list": "playwright test --list && playwright test --config=playwright.admin.config.ts --list",
    "test:e2e:guard": "playwright test --project=local-guard",
    "test:e2e:live": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "demo:passwords": "node scripts/demo-passwords.mjs",
    "cleanup:demo": "node scripts/cleanup-demo.mjs",
    "media:backfill": "node scripts/backfill-vendor-media.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.16.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "next-intl": "^4.15.3",
    "nodemailer": "^10.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
