{
  "name": "gifto-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "postbuild": "node scripts/verify-tailwind-css.mjs",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --config=playwright.admin.config.ts",
    "test:e2e:list": "playwright test --list",
    "test:e2e:guard": "playwright test --project=local-guard",
    "test:e2e:live": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node scripts/seed-demo.mjs",
    "demo:passwords": "node scripts/demo-passwords.mjs",
    "cleanup:demo": "node scripts/cleanup-demo.mjs",
    "demo:catalog:build": "node scripts/demo-catalog/build-dataset.mjs",
    "demo:catalog:art": "node scripts/demo-catalog/generate-artwork.mjs",
    "demo:catalog:validate": "node scripts/demo-catalog/validate.mjs",
    "demo:catalog:import": "node scripts/demo-catalog/import.mjs",
    "demo:catalog:rollback": "node scripts/demo-catalog/rollback.mjs",
    "demo:catalog:dj:build": "node scripts/demo-catalog-dummyjson/build-dataset.mjs",
    "demo:catalog:dj:reports": "node scripts/demo-catalog-dummyjson/build-reports.mjs",
    "demo:catalog:dj:validate": "node scripts/demo-catalog-dummyjson/validate.mjs",
    "demo:catalog:dj:import": "node scripts/demo-catalog-dummyjson/import.mjs",
    "demo:catalog:dj:rollback": "node scripts/demo-catalog-dummyjson/rollback.mjs",
    "demo:catalog:prev:artwork": "node scripts/demo-catalog/refresh-previous-artwork.mjs",
    "demo:catalog:prev:images": "node scripts/demo-catalog/refresh-previous-images.mjs",
    "demo:seed:art": "node scripts/demo-seed/generate-artwork.mjs",
    "demo:seed:profiles": "node scripts/demo-seed/seed-vendor-profiles.mjs",
    "demo:seed:merchandising": "node scripts/demo-seed/seed-merchandising.mjs",
    "demo:seed:orders": "node scripts/demo-seed/seed-orders.mjs",
    "demo:seed:support": "node scripts/demo-seed/seed-support.mjs",
    "media:backfill": "node scripts/backfill-vendor-media.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
