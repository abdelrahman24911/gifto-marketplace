# Gifto Marketplace — environment variables (NAMES ONLY; never commit real values).
# Copy to .env.local and fill in from the Gifto Supabase project dashboard.

# --- Supabase (public — safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SERVER-ONLY — never expose to the browser, never prefix NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Monitoring (P0-02) — NAMES ONLY; never commit real values ---
# Sentry error tracking (free tier). Set in Vercel / the deployment env only.
# The Sentry config files are no-ops when these are unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# UptimeRobot needs no code-side secret; monitors are created in its dashboard
# (see docs/monitoring/UPTIME_ROBOT.md). No API key belongs in this file.

# --- Email notifications (P1-01, CR-02) — NAMES ONLY; never commit real values ---
# SMTP provider chosen by the owner (no provider/account chosen yet — see
# docs/HOSTED_STATE.md "SMTP / notifications"). Until these are set, the mail
# module logs each send as skipped and no email leaves the app.
SMTP_HOST=
SMTP_PORT=587
# true only for implicit-TLS ports (e.g. 465); false for STARTTLS (587).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Send timeout in milliseconds.
SMTP_TIMEOUT_MS=5000

# --- Site ---
# Required in production. Must be the public origin, never localhost there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Keep false during the invite-only beta. Set true only when public indexing is approved.
NEXT_PUBLIC_SEO_INDEXING=false

# --- Deployment environment (P5 demo separation) — NAMES ONLY ---
# Which deployment this instance is: production, staging, demo or
# development. Unset means development. The value is load-bearing:
# demo scripts refuse to run unless it is "demo", the mail module
# refuses to send real email from a demo environment, and the app
# shows a banner on demo/staging. Production deployments MUST set
# it to production; the deployment preflight fails on unknown values.
GIFTO_ENVIRONMENT=development
# Demo email opt-in: only meaningful with GIFTO_ENVIRONMENT=demo.
# Leave unset (sending blocked) unless the isolated demo deployment
# needs test sends — never set this for production.
GIFTO_DEMO_ALLOW_EMAIL=false
# Demo-script safety net (P5): the demo scripts refuse to run against
# a Supabase project whose ref is in this comma-separated list unless
# GIFTO_DEMO_ALLOW_PRODUCTION_PROJECT=true is set explicitly. The
# default list already contains the production project ref
# (hqusykdyjpruysxezsrn); set this only to extend it. The opt-in
# exists only for the pre-separation setup where demo data still
# lives in production — stop using it once the isolated demo
# environment (docs/DEMO_SEPARATION_CHECKLIST.md) is live.
GIFTO_PRODUCTION_PROJECT_REFS=
GIFTO_DEMO_ALLOW_PRODUCTION_PROJECT=false
